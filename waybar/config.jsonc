{
    "height": 28,
    "spacing": 8,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "network",
        "tray"
    ],

  // - Workspaces (Sway) - \\

    "sway/workspaces": {
        "disable-scroll": true
    },

  // - Relógio - \\

    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}"
    },

  // Cpu - Processador

    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },

  // Memória RAM 

    "memory": {
    "format": "RAM: {percentage}%",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },

  // Internet

    "network": {
    "format-ethernet": "  ethernet",
    "format-wifi": "  {signalStrength}%",
    "format-disconnected": "󰖪  offline",
    "tooltip-format-ethernet": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip": true
    },

  // Tray

    "tray": {
        "spacing": 8
    }
}
