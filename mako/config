# Posição e camada
anchor=top-right
layer=overlay

# Tamanho
width=320
height=150
margin=10
padding=10,15

# Tempo (8 segundos)
default-timeout=8000

# Fonte
font=monospace 10

# Tema dark
background-color=#1A1A1AEE
text-color=#CCCCCC
border-color=#3D3D3D
border-size=2
border-radius=6

# Formato: mostra "✕" no título como dica visual
format=<b>%s</b>  ✕\n%b

# Markup e ícones
markup=1
icons=1
max-icon-size=32

# Clique esquerdo = abre ação | clique direito = fecha
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-left=dismiss

# Urgência alta
[urgency=high]
background-color=#2A1A1AEE
border-color=#FF0055
default-timeout=0
